<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C1017">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/topToolbarScroll"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E293B"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/tvStatusBanner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="180dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Connecting..."
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnScreenSelect"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#D4AF37"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="S1"
                    android:textAllCaps="false"
                    android:textColor="#0B0B0E"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnZoomIn"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="+"
                    android:textColor="#F5C542"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnZoomOut"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="2dp"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="-"
                    android:textColor="#F5C542"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnRotate"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Land"
                    android:textAllCaps="false"
                    android:textColor="#F5C542"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnModeToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Mouse"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnRightClick"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#475569"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="R-Clk"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnKeyboard"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#0284C7"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Keyb"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSpecialKeys"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#475569"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Keys"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnQuality"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#475569"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="HD"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnHideBar"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Full"
                    android:textAllCaps="false"
                    android:textColor="#F5C542"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#DC2626"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="X"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.remoteguard.app.RemoteDesktopView
            android:id="@+id/remoteDesktopView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layoutKeyboardBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etTypeText"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#0F172A"
                android:hint="Type text / PIN to send to PC..."
                android:inputType="text"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#64748B" />

            <Button
                android:id="@+id/btnSendText"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#16A34A"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Send"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSendEnter"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#0284C7"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="⏎"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSendBackspace"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#475569"
                android:minWidth="0dp"
                android:paddingHorizontal="10dp"
                android:text="⌫"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Floating pill to restore toolbar when in Full Screen mode -->
    <Button
        android:id="@+id/btnShowBar"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:alpha="0.72"
        android:backgroundTint="#D4AF37"
        android:minWidth="0dp"
        android:paddingHorizontal="10dp"
        android:text="☰ Bar"
        android:textAllCaps="false"
        android:textColor="#0B0B0E"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

</FrameLayout>
