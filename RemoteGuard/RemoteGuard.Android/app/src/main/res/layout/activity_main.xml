<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gold_black_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="FAIM BD RemoteGuard Logo"
                android:src="@drawable/ic_brand_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RemoteGuard"
                    android:textColor="#F5C542"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FAIM BD • 3-Layer Secure Remote"
                    android:textColor="#D4AF37"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTrustStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Checking device trust..."
                android:textColor="#22C55E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeviceId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Device ID: ..."
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVpnStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Network: Checking..."
                android:textColor="#FACC15"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Windows PC Server URL (Cloudflare Tunnel / Tailscale / LAN)"
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etServerUrl"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="#1E293B"
                android:hint="wss://xxxx.trycloudflare.com/ws"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B" />

            <Button
                android:id="@+id/btnCopyUrl"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:backgroundTint="#334155"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:text="Copy"
                android:textAllCaps="false"
                android:textColor="#F5C542"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScanQr"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:backgroundTint="#334155"
                android:text="Scan PC QR Code"
                android:textAllCaps="false"
                android:textColor="#F5C542"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTestConn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Test Connection"
                android:textAllCaps="false"
                android:textColor="#E2E8F0" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#D4AF37"
            android:text="Connect with Fingerprint"
            android:textAllCaps="false"
            android:textColor="#0B0B0E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remote Control Options (Yes / No)"
                android:textColor="#F5C542"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swLandscape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Landscape Mode (Easy Mouse Control)"
                android:textColor="#F8FAFC" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swMouseDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="General Mouse Mode (Trackpad Cursor)"
                android:textColor="#F8FAFC" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swTouchEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Touch Input Option (Yes / No)"
                android:textColor="#F8FAFC" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swKeyboardEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Keyboard Option (Yes / No)"
                android:textColor="#F8FAFC" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPairingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="First-Time Device Pairing"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Required once per phone. After pairing, only Fingerprint is needed unless IP changes or VPN is active."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPairingCode"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="#0F172A"
                android:hint="6-Digit Pairing Code from PC"
                android:inputType="number"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B" />

            <EditText
                android:id="@+id/etMasterPassword"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="#0F172A"
                android:hint="PC Master Password"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="#F8FAFC"
                android:textColorHint="#64748B" />

            <Button
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#16A34A"
                android:text="Pair &amp; Trust This Phone (Fingerprint)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUnpair"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#DC2626"
            android:text="Clear Device Trust (Unpair)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#141418"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Connection Diagnostic Log"
                    android:textColor="#F5C542"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnCopyLog"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#D4AF37"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Copy Log"
                    android:textAllCaps="false"
                    android:textColor="#0B0B0E"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClearLog"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#334155"
                    android:minWidth="0dp"
                    android:paddingHorizontal="10dp"
                    android:text="Clear"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDiagLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="No logs yet."
                android:textColor="#CBD5E1"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
