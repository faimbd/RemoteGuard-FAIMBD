<Window x:Class="WinFixCleanPortable.Views.FileImpactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Safety &amp; Delete Impact Summary"
        Icon="/Assets/app.ico"
        Width="660" Height="510"
        MinWidth="580" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#09090B"
        Foreground="#FAF6EE">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: File Name + Risk Badge -->
        <Border Grid.Row="0" Background="#12110E" BorderBrush="#3A2E14" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <Border x:Name="RiskBadgeBorder" DockPanel.Dock="Right" Background="#D97706" CornerRadius="6" Padding="12,5" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="RiskLevelText" Text="CAUTION" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="FileNameText" Text="example.iso" FontSize="17" FontWeight="Bold" Foreground="#F5C542" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FileMetaText" Text="4.2 GB  •  .ISO" FontSize="12" Foreground="#A8A08E" Margin="0,3,0,2"/>
                    <TextBlock x:Name="FilePathText" Text="C:\Users\..." FontSize="11.5" Foreground="#7A7262" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Impact Summary Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <Border Background="#14120D" BorderBrush="#2E2614" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="RiskTitleText" Text="Summary" FontSize="13.5" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,0,8"/>
                        <TextBlock Text="WHAT IS THIS FILE?" FontSize="10.5" FontWeight="Bold" Foreground="#D4AF37" Margin="0,0,0,3"/>
                        <TextBlock x:Name="WhatIsText" TextWrapping="Wrap" FontSize="12.5" Foreground="#FAF6EE" Margin="0,0,0,10"/>

                        <TextBlock Text="WHAT HAPPENS IF I DELETE IT?" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,3"/>
                        <TextBlock x:Name="ImpactText" TextWrapping="Wrap" FontSize="12.5" Foreground="#FAF6EE" Margin="0,0,0,10"/>

                        <TextBlock Text="RECOMMENDATION" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,3"/>
                        <TextBlock x:Name="RecommendationText" TextWrapping="Wrap" FontSize="12.5" Foreground="#CBD5E1"/>
                    </StackPanel>
                </Border>

                <!-- 1-Click Google Search Summary Panel -->
                <Border Background="#17140C" BorderBrush="#524018" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🌐 Instant Google Search Summary" FontSize="13" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,4"/>
                        <TextBlock Text="Want a second opinion from Google before deleting? Click below to search this exact file and its deletion impact immediately:"
                                   TextWrapping="Wrap" FontSize="12" Foreground="#A8A08E" Margin="0,0,0,10"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="🔍 Google: What is this file?" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="GoogleWhatIs_Click"/>
                            <Button Content="⚠ Google: What happens if I delete it?" Style="{StaticResource WarningButton}" Margin="0,0,8,4" Click="GoogleImpact_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Buttons -->
        <DockPanel Grid.Row="3">
            <Button DockPanel.Dock="Left" Content="📂 Open Location" Style="{StaticResource GhostButton}" Click="OpenLocation_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="♻ Move to Recycle Bin" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="RecycleNow_Click"/>
                <Button Content="🗑 Delete Permanently" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="DeletePermanentNow_Click"/>
                <Button Content="Close" Style="{StaticResource GhostButton}" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
