<Window x:Class="WinFixCleanPortable.Views.AppInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="What is this app?"
        Icon="/Assets/app.ico"
        Width="620" Height="470"
        MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#09090B"
        Foreground="#FAF6EE">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#12110E" BorderBrush="#3A2E14" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <DockPanel>
                <Border x:Name="AdviceBadge" DockPanel.Dock="Right" CornerRadius="6" Padding="10,5" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock x:Name="AdviceLabelText" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
                <StackPanel>
                    <TextBlock x:Name="AppNameText" FontSize="17" FontWeight="Bold" Foreground="#F5C542" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="AppMetaText" FontSize="12" Foreground="#A8A08E" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <Border Background="#14120D" BorderBrush="#2E2614" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="CategoryText" FontSize="13.5" FontWeight="Bold" Foreground="#FDE68A" Margin="0,0,0,8"/>
                        <TextBlock Text="WHAT DOES IT DO?" FontSize="10.5" FontWeight="Bold" Foreground="#D4AF37" Margin="0,0,0,3"/>
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,10"/>
                        <TextBlock Text="WHAT HAPPENS IF I UNINSTALL IT?" FontSize="10.5" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,3"/>
                        <TextBlock x:Name="AdviceText" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,8"/>
                        <Border x:Name="ExtraNoteBorder" Background="#10251C" BorderBrush="#15803D" BorderThickness="1" CornerRadius="5" Padding="9,6" Visibility="Collapsed">
                            <TextBlock x:Name="ExtraNoteText" TextWrapping="Wrap" FontSize="12" Foreground="#BBF7D0"/>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="#17140C" BorderBrush="#524018" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="🌐 Instant Google Search Summary" FontSize="13" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,4"/>
                        <TextBlock Text="Get Google's explanation about this exact app before you remove it:" TextWrapping="Wrap" FontSize="12" Foreground="#A8A08E" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <Button Content="🔍 Google: What is this app?" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="GoogleWhatIs_Click"/>
                            <Button Content="⚠ Google: Is it safe to uninstall?" Style="{StaticResource WarningButton}" Margin="0,0,8,4" Click="GoogleSafe_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <Button DockPanel.Dock="Left" Content="📂 Open Install Folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UninstallBtn" Content="🗑 Clean Uninstall" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="Uninstall_Click"/>
                <Button Content="Close" Style="{StaticResource GhostButton}" Click="Close_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
