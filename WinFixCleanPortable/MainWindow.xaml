<Window x:Class="WinFixCleanPortable.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FaimFixer — Portable Windows Repair, Cleaner &amp; Fast Copy"
        Icon="Assets/app.ico"
        Width="1300" Height="830"
        MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindow}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="244"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand Header (Luxury Black & Gold) -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="9" BorderBrush="#F5C542" BorderThickness="1.5" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FCE38A" Offset="0"/>
                                    <GradientStop Color="#D4AF37" Offset="0.55"/>
                                    <GradientStop Color="#9A7214" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="F" Foreground="#09090B" FontWeight="ExtraBold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="FaimFixer" FontSize="17" FontWeight="Bold" Foreground="#F5C542"/>
                            <TextBlock Text="GOLD PORTABLE SUITE" FontSize="9.5" FontWeight="SemiBold" Foreground="#B5AA92"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Bottom Portable / Admin Info -->
                <Border DockPanel.Dock="Bottom" Margin="12,10,12,14" Padding="12" CornerRadius="8" Background="#12100B" BorderBrush="#3A2E14" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="#F5C542" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="AdminStatusText" Text="Standard User" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <TextBlock x:Name="WindowsVersionText" Text="Windows" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                        <Button x:Name="SidebarElevateBtn" Content="Restart as Admin" Style="{StaticResource PrimaryButton}" Padding="10,6" FontSize="12" Click="RestartAsAdmin_Click"/>
                        <TextBlock Text="Portable • Zero Registry Writes" FontSize="10.5" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Items -->
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="WORKSPACE" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="22,6,0,6"/>
                    <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItemStyle}" IsChecked="True" Checked="Nav_Checked" Tag="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavRepair" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="Repair">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Windows Repair" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavLargeFiles" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="LargeFiles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Large &amp; ZIP / ISO" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDuplicates" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="Duplicates">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⧉" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Duplicate Finder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavFastCopy" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="FastCopy">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Smart Fast Copy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavUninstaller" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="Uninstaller">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="App Uninstaller" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavDriveFix" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="DriveFix">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💽" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Drive Fix &amp; Format" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavBoot" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="Boot">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Boot Menu Manager" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavJunk" Style="{StaticResource NavItemStyle}" Checked="Nav_Checked" Tag="Junk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧹" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Junk Cleaner" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar (Black & Gold) -->
            <Border Grid.Row="0" Background="#0C0B08" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" Text="Dashboard" FontSize="19" FontWeight="Bold" Foreground="#F5C542"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="System overview, drive health, and quick cleanup tools" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="📋 Open Log" Style="{StaticResource GhostButton}" Padding="11,6" FontSize="12" Margin="0,0,8,0" Click="OpenAppLog_Click"/>
                        <Button Content="↻ Refresh Drives" Style="{StaticResource GhostButton}" Padding="11,6" FontSize="12" Click="RefreshDrives_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== PAGE 1: DASHBOARD ==================== -->
            <ScrollViewer x:Name="PageDashboard" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <!-- Quick Actions Row -->
                    <TextBlock Text="Quick Tools" FontSize="15" FontWeight="SemiBold" Foreground="#FDE68A" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <!-- Card 1: Windows Repair -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,12">
                            <StackPanel>
                                <TextBlock Text="🛠 Windows Repair &amp; Missing Files" FontSize="15" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,6"/>
                                <TextBlock Text="Detect missing or corrupted Windows files (SFC / DISM / CBS.log) and check critical System32 DLLs with one-click auto repair."
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
                                <Button Content="Open Windows Repair" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="GoToRepair_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Large & ZIP/ISO -->
                        <Border Style="{StaticResource CardBorder}" Margin="8,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📦 Large Files &amp; ZIP / ISO Finder" FontSize="15" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,6"/>
                                <TextBlock Text="List huge files, .ZIP, .RAR, .7Z archives, and .ISO disk images with hover instant-delete &amp; Google Safety Summary popup."
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
                                <Button Content="Scan Large / ZIP / ISO" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="GoToLargeFiles_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Duplicate Finder -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,6">
                            <StackPanel>
                                <TextBlock Text="⧉ Custom Duplicate File Cleaner" FontSize="15" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,6"/>
                                <TextBlock Text="Pick any folders you choose and find 100% SHA-256 verified identical duplicates with smart auto-select to safely delete extra copies."
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
                                <Button Content="Find Duplicates" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="GoToDuplicates_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Smart Fast Copy -->
                        <Border Style="{StaticResource CardBorder}" Margin="8,0,0,6">
                            <StackPanel>
                                <TextBlock Text="⚡ Multi-Threaded Smart Fast Copy" FontSize="15" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,6"/>
                                <TextBlock Text="Copy/Move files at max speed using parallel threads with zero missing files (SHA-256 verified), zero duplicates, and auto Better Quality selection."
                                           TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,14"/>
                                <Button Content="Open Smart Fast Copy" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="GoToFastCopy_Click"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Storage Drives Overview -->
                    <TextBlock Text="Connected Storage Drives" FontSize="15" FontWeight="SemiBold" Foreground="#FDE68A" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="DashboardDrivesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="310" Margin="0,0,14,14">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayTitle}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                            <Border DockPanel.Dock="Right" Background="#1D180D" BorderBrush="#4A3B18" BorderThickness="1" CornerRadius="5" Padding="7,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DriveFormat}" FontSize="11" Foreground="#F5C542"/>
                                            </Border>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,2,0,8"/>
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding UsageText}" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FreeText}" FontSize="12" FontWeight="SemiBold" Foreground="#F5C542" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <Button Content="Scan Large &amp; ZIP/ISO on Drive" Style="{StaticResource GhostButton}" Padding="10,6" FontSize="12"
                                                Tag="{Binding Name}" Click="DashboardScanDrive_Click"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Safety Note -->
                    <Border Style="{StaticResource CardBorder}" Background="#15120B" BorderBrush="#4A3B18" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="Portable &amp; Safe by Design" FontSize="13.5" FontWeight="Bold" Foreground="#F5C542" Margin="0,0,0,4"/>
                            <TextBlock Text="• Hover or click any file in Large &amp; ZIP/ISO or Duplicates to see instant 'Safe?' Summary + Google Search, Recycle Bin, and Permanent Delete buttons.&#x0a;• Windows Repair uses official Microsoft SFC, DISM, and CHKDSK utilities and parses CBS.log to show exactly which files were missing, corrupted, or repaired."
                                       TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PAGE 2: WINDOWS REPAIR ==================== -->
            <Grid x:Name="PageRepair" Grid.Row="1" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Admin Warning Banner (hidden when elevated) -->
                <Border x:Name="RepairAdminBanner" Grid.Row="0" Background="#3B2506" BorderBrush="#D97706" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restart as Administrator" Style="{StaticResource WarningButton}" Padding="12,6" Click="RestartAsAdmin_Click"/>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Administrator privileges recommended for SFC / DISM / CHKDSK repairs" FontWeight="Bold" FontSize="13" Foreground="#FDE68A"/>
                            <TextBlock Text="You can still run Instant Missing DLL Check &amp; CBS.log inspection right now, or restart elevated for full Windows repair." FontSize="12" Foreground="#FCD34D"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Repair Action Buttons Card -->
                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Windows System File Diagnostics &amp; Repair Actions" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="RepairStopBtn" Content="⏹ Stop Task" Style="{StaticResource DangerButton}" Padding="11,6" FontSize="12" IsEnabled="False" Margin="0,0,8,0" Click="RepairStop_Click"/>
                                <Button Content="💾 Export Report (.txt)" Style="{StaticResource GhostButton}" Padding="11,6" FontSize="12" Click="RepairExportReport_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="BtnAutoRepair" Content="⚡ Smart Full Auto-Repair (DISM + SFC)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="RepairAutoFull_Click"/>
                            <Button x:Name="BtnCheckDlls" Content="🔍 Check Missing System DLLs (Instant)" Style="{StaticResource SuccessButton}" Margin="0,0,8,8" Click="RepairCheckDlls_Click"/>
                            <Button x:Name="BtnSfcVerify" Content="📋 Scan Missing Files (SFC /verifyonly)" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairSfcVerify_Click"/>
                            <Button x:Name="BtnSfcRepair" Content="🛠 Repair Missing Files (SFC /scannow)" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairSfcScannow_Click"/>
                            <Button x:Name="BtnDismCheck" Content="🩺 DISM CheckHealth" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairDismCheck_Click"/>
                            <Button x:Name="BtnDismRestore" Content="🩹 DISM RestoreHealth" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairDismRestore_Click"/>
                            <Button x:Name="BtnChkdsk" Content="💽 Online Disk Scan (CHKDSK)" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairChkdsk_Click"/>
                            <Button x:Name="BtnNetReset" Content="🌐 Reset Network &amp; DNS" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairNetworkReset_Click"/>
                            <Button x:Name="BtnParseCbs" Content="📄 Inspect CBS.log Issues" Style="{StaticResource GhostButton}" Margin="0,0,8,8" Click="RepairParseCbs_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Status Progress Strip -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RepairStatusText" Text="Ready. Click 'Check Missing System DLLs' for an instant check or 'Smart Full Auto-Repair' to repair Windows."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="RepairProgressBar" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- Split Results Area: Missing Files Table + Live Console -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.15*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="0.95*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Table: Missing / Corrupted / Repaired Files -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" x:Name="MissingFilesHeader" Text="Missing, Corrupted &amp; Checked System Files" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock DockPanel.Dock="Right" x:Name="MissingFilesSummary" Text="Run a scan to populate" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DataGrid x:Name="MissingFilesGrid" Style="{StaticResource DarkDataGrid}" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="210"/>
                                    <DataGridTemplateColumn Header="Status" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="11.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="160"/>
                                    <DataGridTextColumn Header="Details / Recommendation" Binding="{Binding Details}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Console: Live Repair Output -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Text="Live Repair Console Output" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <Button DockPanel.Dock="Right" Content="Clear Log" Style="{StaticResource ChipButton}" HorizontalAlignment="Right" Click="RepairClearLog_Click"/>
                            </DockPanel>
                            <TextBox x:Name="RepairLogBox"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="#070708"
                                     Foreground="#EADCB6"
                                     BorderBrush="#2E2614"
                                     BorderThickness="1"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Padding="10"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== PAGE 3: LARGE & ZIP/ISO FILES ==================== -->
            <Grid x:Name="PageLargeFiles" Grid.Row="1" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scan Targets & Options Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- Row 1: Drives & Custom Folder Picker -->
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Left" Text="Scan Locations:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Add Custom Folder" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="LargeAddFolder_Click"/>
                                <Button Content="Clear Custom" Style="{StaticResource ChipButton}" Click="LargeClearCustom_Click"/>
                            </StackPanel>
                            <ItemsControl x:Name="LargeDrivesItems" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding DisplayTitle}" Margin="0,0,14,0" FontWeight="SemiBold"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>

                        <TextBlock x:Name="LargeCustomFoldersLabel" Text="Custom folders: (none added — selected drives above will be scanned)" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>

                        <!-- Row 2: Category & Size Settings + Scan Button -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="LargeScanBtn" Content="🔍 Start Scan" Style="{StaticResource PrimaryButton}" Padding="16,7" Margin="0,0,8,0" Click="LargeStartScan_Click"/>
                                <Button x:Name="LargeStopBtn" Content="⏹ Stop" Style="{StaticResource DangerButton}" Padding="12,7" IsEnabled="False" Click="LargeStopScan_Click"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="ChkIncludeLarge" IsChecked="True" Content="Large Files ≥" Margin="0,0,6,4"/>
                                <ComboBox x:Name="CmbMinLargeSize" Style="{StaticResource DarkComboBox}" Width="105" Margin="0,0,14,4" SelectedIndex="2">
                                    <ComboBoxItem Content="25 MB" Tag="25"/>
                                    <ComboBoxItem Content="50 MB" Tag="50"/>
                                    <ComboBoxItem Content="100 MB" Tag="100"/>
                                    <ComboBoxItem Content="250 MB" Tag="250"/>
                                    <ComboBoxItem Content="500 MB" Tag="500"/>
                                    <ComboBoxItem Content="1 GB" Tag="1024"/>
                                    <ComboBoxItem Content="2 GB" Tag="2048"/>
                                </ComboBox>
                                <CheckBox x:Name="ChkIncludeArchives" IsChecked="True" Content="ZIP / RAR / 7Z Archives" Margin="0,0,14,4"/>
                                <CheckBox x:Name="ChkIncludeIso" IsChecked="True" Content="ISO / IMG / Disk Images" Margin="0,0,14,4"/>
                                <CheckBox x:Name="ChkIncludeMedia" IsChecked="False" Content="Installers &amp; Videos (&gt;20 MB)" Margin="0,0,14,4"/>
                                <CheckBox x:Name="ChkSkipSystem" IsChecked="True" Content="Skip Windows System Folders" Margin="0,0,8,4"/>
                            </WrapPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Scan Progress Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LargeStatusText" Text="Select drives or folders above and click 'Start Scan' to list large files, ZIPs, and ISOs."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="LargeProgressBar" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- Instant Filter Chips + Search Bar -->
                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ChipAll" Content="All" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="ALL" Click="LargeFilterChip_Click"/>
                        <Button x:Name="ChipIso" Content="ISO / Disk Images" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="ISO" Click="LargeFilterChip_Click"/>
                        <Button x:Name="ChipZip" Content="ZIP / Archives" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="ARCHIVE" Click="LargeFilterChip_Click"/>
                        <Button x:Name="ChipLarge" Content="Large Files" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="LARGE" Click="LargeFilterChip_Click"/>
                        <Button x:Name="ChipOver500" Content="&gt; 500 MB" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Tag="500MB" Click="LargeFilterChip_Click"/>
                        <Button x:Name="ChipOver1GB" Content="&gt; 1 GB" Style="{StaticResource ChipButton}" Margin="0,0,12,0" Tag="1GB" Click="LargeFilterChip_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Filter:" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="LargeSearchBox" Style="{StaticResource DarkTextBox}" Width="210" Margin="0,0,8,0" TextChanged="LargeSearchBox_TextChanged"/>
                        <Button Content="Select Visible" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="LargeSelectVisible_Click"/>
                        <Button Content="Clear" Style="{StaticResource ChipButton}" Click="LargeClearSelection_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Results DataGrid with Hover & Click Instant Actions -->
                <DataGrid x:Name="LargeFilesGrid" Grid.Row="3" Style="{StaticResource DarkDataGrid}" MouseDoubleClick="LargeFilesGrid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="ℹ Safe to Delete? (Impact Summary + Google Search)" Click="LargeInspectImpact_Click"/>
                            <MenuItem Header="📂 Open File Location in Explorer" Click="LargeOpenLocation_Click"/>
                            <MenuItem Header="📋 Copy Full Path" Click="LargeCopyPath_Click"/>
                            <Separator/>
                            <MenuItem Header="♻ Move to Recycle Bin (Safe)" Click="LargeContextRecycle_Click"/>
                            <MenuItem Header="🗑 Delete Permanently" Click="LargeContextPermDelete_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Sel" Width="42">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="LargeRowCheck_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="220" IsReadOnly="True"/>
                        <!-- Hover / Click Instant Actions RIGHT NEXT TO FILE -->
                        <DataGridTemplateColumn Header="Quick Actions (Hover / Click)" Width="188">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="ℹ Safe?" ToolTip="View delete impact summary &amp; Google search" Style="{StaticResource InlineInfoButton}" Margin="0,0,4,0" Tag="{Binding}" Click="LargeRowInfo_Click"/>
                                        <Button Content="♻" ToolTip="Instant Move to Recycle Bin" Style="{StaticResource InlineRecycleButton}" Margin="0,0,4,0" Tag="{Binding}" Click="LargeRowRecycle_Click"/>
                                        <Button Content="🗑 Del" ToolTip="Instant Permanent Delete" Style="{StaticResource InlineDeleteButton}" Tag="{Binding}" Click="LargeRowPermDelete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Type" Width="125" SortMemberPath="Category">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" SortMemberPath="SizeBytes" Width="96" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedText}" SortMemberPath="LastModified" Width="125" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Folder Path" Binding="{Binding DirectoryPath}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bottom Action Bar -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" x:Name="LargeSelectionSummary" Text="0 items visible • 0 selected (0 B)" FontSize="13" FontWeight="SemiBold" Foreground="#FDE68A" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ℹ Safe? (Google Summary)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="LargeInspectImpact_Click"/>
                            <Button Content="📂 Open Location" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="LargeOpenLocation_Click"/>
                            <Button Content="♻ Move Selected to Recycle Bin" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="LargeRecycleSelected_Click"/>
                            <Button Content="🗑 Delete Permanently" Style="{StaticResource DangerButton}" Click="LargePermanentDelete_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==================== PAGE 4: DUPLICATE FINDER ==================== -->
            <Grid x:Name="PageDuplicates" Grid.Row="1" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom Locations Picker + Options -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: User-Selected Locations -->
                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Target Folders to Check for Duplicates" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Add Folder..." Style="{StaticResource PrimaryButton}" Padding="10,5" FontSize="12" Margin="0,0,6,0" Click="DupAddFolder_Click"/>
                                    <Button Content="Remove" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="DupRemoveFolder_Click"/>
                                    <Button Content="Clear" Style="{StaticResource ChipButton}" Click="DupClearFolders_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="DupFoldersList" Style="{StaticResource DarkListBox}" Height="78" Margin="0,0,0,6"/>
                            <WrapPanel Orientation="Horizontal">
                                <TextBlock Text="Quick Add:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Content="+ Downloads" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="Downloads" Click="DupQuickAdd_Click"/>
                                <Button Content="+ Desktop" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="Desktop" Click="DupQuickAdd_Click"/>
                                <Button Content="+ Documents" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="Documents" Click="DupQuickAdd_Click"/>
                                <Button Content="+ Pictures" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="Pictures" Click="DupQuickAdd_Click"/>
                                <Button Content="+ Videos" Style="{StaticResource ChipButton}" Tag="Videos" Click="DupQuickAdd_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Right: Scan Options & Trigger -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                            <TextBlock Text="Duplicate Scan Settings" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Minimum Size" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbDupMinSize" Style="{StaticResource DarkComboBox}" SelectedIndex="1">
                                        <ComboBoxItem Content="Any (&gt; 0 B)" Tag="1"/>
                                        <ComboBoxItem Content="100 KB" Tag="102400"/>
                                        <ComboBoxItem Content="1 MB" Tag="1048576"/>
                                        <ComboBoxItem Content="10 MB" Tag="10485760"/>
                                        <ComboBoxItem Content="50 MB" Tag="52428800"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="File Type" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbDupFileType" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="All Files" Tag="ALL"/>
                                        <ComboBoxItem Content="Images" Tag="IMG"/>
                                        <ComboBoxItem Content="Videos" Tag="VID"/>
                                        <ComboBoxItem Content="ZIP / ISO / Archives" Tag="ARC"/>
                                        <ComboBoxItem Content="Documents (PDF/Office)" Tag="DOC"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                <CheckBox x:Name="ChkDupSubfolders" IsChecked="True" Content="Include Subfolders" Margin="0,0,14,0"/>
                                <CheckBox x:Name="ChkDupSkipHidden" IsChecked="True" Content="Skip Hidden/System"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="DupScanBtn" Content="🔍 Find Duplicates (SHA-256)" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="DupStartScan_Click"/>
                                <Button x:Name="DupStopBtn" Content="⏹ Stop" Style="{StaticResource DangerButton}" IsEnabled="False" Click="DupStopScan_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Progress Strip -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DupStatusText" Text="Add one or more folders above, then click 'Find Duplicates' to scan with 100% accurate SHA-256 verification."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="DupProgressBar" Grid.Column="1" VerticalAlignment="Center" Maximum="100" Value="0"/>
                </Grid>

                <!-- Smart Auto-Select Toolbar -->
                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="Smart Auto-Select:" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Keep Oldest (Select Newer)" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="DupKeepOldest_Click"/>
                        <Button Content="Keep Newest (Select Older)" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="DupKeepNewest_Click"/>
                        <Button Content="Keep Shortest Path" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="DupKeepShortest_Click"/>
                        <Button Content="Clear Selection" Style="{StaticResource ChipButton}" Click="DupClearSelection_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="DupStatsLabel" Text="0 groups • 0 B wasted" FontSize="12.5" FontWeight="SemiBold" Foreground="#F5C542" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>

                <!-- Grouped Duplicates DataGrid -->
                <DataGrid x:Name="DuplicatesGrid" Grid.Row="3" Style="{StaticResource DarkDataGrid}" MouseDoubleClick="DuplicatesGrid_MouseDoubleClick">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#1B170D" BorderBrush="#4A3B18" BorderThickness="0,1,0,1" Padding="12,7">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12.5" Foreground="#F5C542"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Delete" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Click="DupRowCheck_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="210" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Quick Actions (Hover / Click)" Width="188">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button Content="ℹ Safe?" ToolTip="View delete impact summary &amp; Google search" Style="{StaticResource InlineInfoButton}" Margin="0,0,4,0" Tag="{Binding}" Click="DupRowInfo_Click"/>
                                        <Button Content="♻" ToolTip="Instant Move to Recycle Bin" Style="{StaticResource InlineRecycleButton}" Margin="0,0,4,0" Tag="{Binding}" Click="DupRowRecycle_Click"/>
                                        <Button Content="🗑 Del" ToolTip="Instant Permanent Delete" Style="{StaticResource InlineDeleteButton}" Tag="{Binding}" Click="DupRowPermDelete_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="96" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Modified" Binding="{Binding LastModifiedText}" Width="125" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Full Folder Path" Binding="{Binding DirectoryPath}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bottom Action Bar -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" x:Name="DupSelectionSummary" Text="0 duplicates selected (0 B to reclaim)" FontSize="13" FontWeight="SemiBold" Foreground="#FDE68A" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="ℹ Safe? (Google Summary)" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="DupInspectImpact_Click"/>
                            <Button Content="📂 Open Location" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="DupOpenLocation_Click"/>
                            <Button Content="♻ Move Selected to Recycle Bin" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="DupRecycleSelected_Click"/>
                            <Button Content="🗑 Delete Permanently" Style="{StaticResource DangerButton}" Click="DupPermanentDelete_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==================== PAGE 5: SMART FAST COPY ==================== -->
            <Grid x:Name="PageFastCopy" Grid.Row="1" Visibility="Collapsed" Margin="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Source, Destination & Thread/Quality Settings Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="1.25*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Sources -->
                        <StackPanel Grid.Column="0">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="Source Folders / Files" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="+ Folder" Style="{StaticResource PrimaryButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="CopyAddSourceFolder_Click"/>
                                    <Button Content="+ Files" Style="{StaticResource GhostButton}" Padding="9,4" FontSize="12" Margin="0,0,5,0" Click="CopyAddSourceFiles_Click"/>
                                    <Button Content="Remove" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="CopyRemoveSource_Click"/>
                                    <Button Content="Clear" Style="{StaticResource ChipButton}" Click="CopyClearSources_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <ListBox x:Name="CopySourcesList" Style="{StaticResource DarkListBox}" Height="96"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <CheckBox x:Name="ChkCopyZeroDuplicates" IsChecked="True" Content="Zero Duplicates (SHA-256)" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkCopyVerify" IsChecked="True" Content="Verify Integrity (Zero Missing)" Margin="0,0,12,0"/>
                                <CheckBox x:Name="ChkCopyKeepStructure" IsChecked="True" Content="Keep Subfolders"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Destination, Mode, Threads, Conflict Policy -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Destination Folder" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0" Click="CopyBrowseDest_Click"/>
                                <TextBox x:Name="CopyDestTextBox" Style="{StaticResource DarkTextBox}" VerticalContentAlignment="Center"/>
                            </DockPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="0.85*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Operation Mode" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbCopyMode" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="Copy (Safe)" Tag="COPY"/>
                                        <ComboBoxItem Content="Move (Cut &amp; Paste)" Tag="MOVE"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Parallel Threads" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbCopyThreads" Style="{StaticResource DarkComboBox}" SelectedIndex="0">
                                        <ComboBoxItem Content="Auto (Fast)" Tag="0"/>
                                        <ComboBoxItem Content="2 Threads" Tag="2"/>
                                        <ComboBoxItem Content="4 Threads" Tag="4"/>
                                        <ComboBoxItem Content="8 Threads" Tag="8"/>
                                        <ComboBoxItem Content="12 Threads" Tag="12"/>
                                        <ComboBoxItem Content="16 Threads" Tag="16"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="When Duplicate / Same Name Found" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbCopyPolicy" Style="{StaticResource DarkComboBox}" SelectedIndex="0" SelectionChanged="CmbCopyPolicy_SelectionChanged">
                                        <ComboBoxItem Content="Auto: Keep Better Quality" Tag="QUALITY"/>
                                        <ComboBoxItem Content="Let Me Choose Each Conflict" Tag="ASK"/>
                                        <ComboBoxItem Content="Keep Larger File" Tag="LARGER"/>
                                        <ComboBoxItem Content="Keep Newer File" Tag="NEWER"/>
                                        <ComboBoxItem Content="Skip Existing / Duplicates" Tag="SKIP"/>
                                        <ComboBoxItem Content="Overwrite Destination" Tag="OVERWRITE"/>
                                        <ComboBoxItem Content="Keep Both (Auto-Rename)" Tag="RENAME"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CopyAnalyzeBtn" Content="🔍 Analyze &amp; Preview Quality" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CopyAnalyze_Click"/>
                                <Button x:Name="CopyStartBtn" Content="⚡ Start Fast Copy" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="CopyStart_Click"/>
                                <Button x:Name="CopyStopBtn" Content="⏹ Stop" Style="{StaticResource DangerButton}" IsEnabled="False" Click="CopyStop_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Live Progress & Speed Row -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CopyStatusText" Text="Add source folders/files and a destination folder. Click 'Analyze' to preview quality choices or 'Start Fast Copy' directly."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ProgressBar x:Name="CopyProgressBar" Maximum="100" Value="0" Height="8"/>
                        <TextBlock x:Name="CopySpeedText" Text="Speed: —" FontSize="11" Foreground="#F5C542" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Filter & Conflict Choice Bulk Toolbar -->
                <DockPanel Grid.Row="2" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="CopyChipAll" Content="All" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="ALL" Click="CopyFilterChip_Click"/>
                        <Button x:Name="CopyChipConflicts" Content="Conflicts (Choose)" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="CONFLICTS" Click="CopyFilterChip_Click"/>
                        <Button x:Name="CopyChipDuplicates" Content="Duplicates (Skipped)" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="DUPS" Click="CopyFilterChip_Click"/>
                        <Button x:Name="CopyChipNew" Content="New Files" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Tag="NEW" Click="CopyFilterChip_Click"/>
                        <Button x:Name="CopyChipFailed" Content="Failed" Style="{StaticResource ChipButton}" Margin="0,0,10,0" Tag="FAILED" Click="CopyFilterChip_Click"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Conflicts Bulk Action:" FontSize="11.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="Auto Better Quality" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="CopyBulkBetterQuality_Click"/>
                        <Button Content="Use All Source" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="CopyBulkUseSource_Click"/>
                        <Button Content="Keep All Dest" Style="{StaticResource ChipButton}" Margin="0,0,5,0" Click="CopyBulkKeepDest_Click"/>
                        <Button Content="Keep Both" Style="{StaticResource ChipButton}" Click="CopyBulkKeepBoth_Click"/>
                    </StackPanel>
                </DockPanel>

                <!-- Transfer Plan & Conflict Resolution Grid -->
                <DataGrid x:Name="CopyPlanGrid" Grid.Row="3" Style="{StaticResource DarkDataGrid}" RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File" Binding="{Binding RelativePath}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Source (Size / Quality / Date)" Binding="{Binding SourceSummary}" Width="210" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Destination (Existing)" Binding="{Binding DestSummary}" Width="210" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Your Choice / Action" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox SelectedIndex="{Binding DecisionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource DarkComboBox}"
                                              Height="28" FontSize="11.5" Padding="6,2">
                                        <ComboBoxItem Content="Use Source (Copy/Replace)"/>
                                        <ComboBoxItem Content="Keep Dest (Skip)"/>
                                        <ComboBoxItem Content="Keep Both (Rename)"/>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="145" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Quality Comparison / Details" Binding="{Binding Reason}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bottom Summary & Actions Bar -->
                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" x:Name="CopySummaryText" Text="0 files in queue" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📂 Open Destination" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="CopyOpenDest_Click"/>
                            <Button Content="💾 Export Copy Log" Style="{StaticResource GhostButton}" Click="CopyExportLog_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ==================== PAGE 6: CLEAN APP UNINSTALLER ==================== -->
            <Grid x:Name="PageUninstaller" Grid.Row="1" Visibility="Collapsed" Margin="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search & Action Toolbar Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Search Apps:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="UninstSearchBox" Style="{StaticResource DarkTextBox}" Width="260" Margin="0,0,12,0" TextChanged="UninstSearchBox_TextChanged"/>
                                <CheckBox x:Name="ChkUninstShowSystem" Content="Show System Components" Checked="UninstRefresh_Click" Unchecked="UninstRefresh_Click"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="UninstRefreshBtn" Content="↻ Refresh Apps" Style="{StaticResource GhostButton}" Padding="11,6" FontSize="12" Click="UninstRefresh_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <WrapPanel Orientation="Horizontal">
                            <Button x:Name="UninstCleanBtn" Content="🗑 Clean Uninstall (Uninstall + Deep Leftover Scan)" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="UninstCleanUninstall_Click"/>
                            <Button x:Name="UninstScanLeftoversBtn" Content="🔍 Scan Leftovers Only (AppData / Registry)" Style="{StaticResource WarningButton}" Margin="0,0,8,0" Click="UninstScanLeftovers_Click"/>
                            <Button Content="ℹ What is this app? (Google)" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="UninstInfo_Click"/>
                            <Button Content="📂 Open Install Folder" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="UninstOpenFolder_Click"/>
                        </WrapPanel>
                        <TextBlock Text="💡 Hover over any app to see what it does. Teal 'Chrome Web App' items (YouTube, Gmail…) uninstall ONLY that web app — Google Chrome stays installed."
                                   FontSize="11.5" Foreground="#B5AA92" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Status Bar -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UninstStatusText" Text="Select any installed application below and click 'Clean Uninstall' to remove the program plus leftover folders and registry traces."
                               FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="UninstProgressBar" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <!-- Split View: Installed Apps (Top) + Leftovers Review & Clean (Bottom) -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.25*"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="0.95*"/>
                    </Grid.RowDefinitions>

                    <!-- Installed Apps Grid (hover any row = "What does this app do?" popup) -->
                    <DataGrid x:Name="InstalledAppsGrid" Grid.Row="0" Style="{StaticResource DarkDataGrid}" IsReadOnly="True" RowHeight="40">
                        <DataGrid.Resources>
                            <!-- x:Shared=False => a fresh popup instance per row -->
                            <StackPanel x:Key="AppInfoTip" x:Shared="False" MaxWidth="440">
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" Foreground="#F5C542" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,8">
                                    <Border Background="#2A220F" BorderBrush="#6B531D" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding InfoCategory}" FontSize="11" FontWeight="SemiBold" Foreground="#FDE68A"/>
                                    </Border>
                                    <Border Background="{Binding InfoAdviceColor}" CornerRadius="4" Padding="7,2">
                                        <TextBlock Text="{Binding InfoAdviceLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="WHAT DOES IT DO?" FontSize="10" FontWeight="Bold" Foreground="#D4AF37" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding InfoDescription}" FontSize="12" TextWrapping="Wrap" Foreground="#FAF6EE" Margin="0,0,0,8"/>
                                <TextBlock Text="IF I UNINSTALL IT?" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding InfoAdvice}" FontSize="12" TextWrapping="Wrap" Foreground="#E7DFCB" Margin="0,0,0,6"/>
                                <Border Background="#10251C" BorderBrush="#15803D" BorderThickness="1" CornerRadius="5" Padding="8,5" Margin="0,2,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasExtraNote}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding InfoExtraNote}" FontSize="11.5" TextWrapping="Wrap" Foreground="#BBF7D0"/>
                                </Border>
                                <TextBlock Text="{Binding InfoFooter}" FontSize="10.5" Foreground="#8C8270" TextWrapping="Wrap"/>
                                <TextBlock Text="Tip: click 'ℹ Info' for Google search summary" FontSize="10.5" FontStyle="Italic" Foreground="#786F5C" Margin="0,3,0,0"/>
                            </StackPanel>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRowStyle}">
                                <Setter Property="ToolTip" Value="{StaticResource AppInfoTip}"/>
                                <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
                                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                                <Setter Property="ToolTipService.Placement" Value="Mouse"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application Name" Binding="{Binding DisplayName}" Width="240" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Quick Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="ℹ Info" ToolTip="What does this app do? + Google search" Style="{StaticResource InlineInfoButton}" Margin="0,0,4,0" Tag="{Binding}" Click="UninstRowInfo_Click"/>
                                            <Button Content="🗑 Uninstall" ToolTip="Clean Uninstall this app" Style="{StaticResource InlineDeleteButton}" Tag="{Binding}" Click="UninstRowUninstall_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="What it is" Width="150" SortMemberPath="InfoCategory">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InfoCategory}" Foreground="#E7D9B0" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="150"/>
                            <DataGridTextColumn Header="Version" Binding="{Binding DisplayVersion}" Width="95"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" SortMemberPath="EstimatedSizeBytes" Width="85" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="Type" Width="125" SortMemberPath="ScopeLabel">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ScopeColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding ScopeLabel}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Installed" Binding="{Binding InstallDate}" Width="92"/>
                            <DataGridTextColumn Header="Install Location" Binding="{Binding InstallLocation}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Card: Deep Leftover Files & Registry Traces -->
                    <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" x:Name="LeftoversHeader" Text="Clean Uninstall Leftovers (Files, AppData, Shortcuts &amp; Registry Traces)" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Select All" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="LeftoversSelectAll_Click"/>
                                    <Button Content="Clear" Style="{StaticResource ChipButton}" Margin="0,0,10,0" Click="LeftoversClearSel_Click"/>
                                    <Button x:Name="LeftoversRecycleBtn" Content="♻ Clean Selected Leftovers (Safe)" Style="{StaticResource SuccessButton}" Padding="12,6" FontSize="12" Margin="0,0,6,0" Click="LeftoversCleanSafe_Click"/>
                                    <Button x:Name="LeftoversPermBtn" Content="🗑 Delete Permanently" Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12" Click="LeftoversCleanPermanent_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="LeftoversGrid" Style="{StaticResource DarkDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Clean" Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Kind" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding BadgeColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Kind}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Location Type" Binding="{Binding LocationCategory}" Width="165" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="88" IsReadOnly="True" FontWeight="SemiBold"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Full Path / Registry Key" Binding="{Binding TargetPath}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== PAGE: DRIVE FIX & FORMAT ==================== -->
            <Grid x:Name="PageDriveFix" Grid.Row="1" Visibility="Collapsed" Margin="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <Border x:Name="DriveAdminBanner" Grid.Row="0" Background="#2A1F08" BorderBrush="#B8860B" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restart as Administrator" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="RestartAsAdmin_Click"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FDE68A" FontSize="12.5"
                                   Text="Administrator rights are needed to scan, fix and format pen drives / hard disks."/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="DriveScanBtn" Content="↻ Scan All Drives" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="DriveScan_Click"/>
                            <Button Content="🔄 Rescan Hardware" Style="{StaticResource GhostButton}" Margin="0,0,8,4" Click="DriveRescanHw_Click"/>
                            <Button Content="🔓 Remove USB Write-Protection (Registry)" Style="{StaticResource GhostButton}" Margin="0,0,8,4" Click="DriveWriteProtect_Click"/>
                        </WrapPanel>
                        <TextBlock FontSize="11.5" Foreground="#B5AA92" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="💡 Pen drive / hard disk not showing? Plug it in, click 'Scan All Drives', select the red '⚠ Needs Fix' row and use the suggested fix. The Windows disk and the disk this app runs from are locked 🔒 and can never be formatted."/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="DriveStatusText" Text="Click 'Scan All Drives' to detect hidden, offline, read-only or RAW drives." FontSize="12.5" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="DriveProgressBar" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>

                <DataGrid x:Name="DrivesGrid" Grid.Row="3" Style="{StaticResource DarkDataGrid}" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRowStyle}">
                            <Setter Property="ToolTip" Value="{Binding InfoText}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="115" SortMemberPath="StatusText">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Disk" Binding="{Binding DiskTitle}" Width="210" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Bus" Binding="{Binding BusType}" Width="60"/>
                        <DataGridTextColumn Header="Letter" Binding="{Binding LetterDisplay}" Width="62" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="110"/>
                        <DataGridTextColumn Header="File System" Binding="{Binding FileSystemDisplay}" Width="85"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="85"/>
                        <DataGridTextColumn Header="Free" Binding="{Binding FreeDisplay}" Width="80"/>
                        <DataGridTextColumn Header="Problems / Suggested Fix" Binding="{Binding ProblemsText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,8">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="FIX:" FontWeight="Bold" Foreground="#F5C542" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button Content="🔌 Bring Online" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="DriveOnline_Click"/>
                            <Button Content="🔓 Clear Read-Only" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="DriveReadOnly_Click"/>
                            <Button Content="🔤 Assign Drive Letter" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="DriveAssignLetter_Click"/>
                            <Button Content="🛠 Repair File System (CHKDSK /F)" Style="{StaticResource SuccessButton}" Margin="0,0,6,4" Click="DriveRepair_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="FORMAT:" FontWeight="Bold" Foreground="#F5C542" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="CmbFormatFs" Style="{StaticResource DarkComboBox}" Width="95" Margin="0,0,6,4" SelectedIndex="0">
                                <ComboBoxItem Content="exFAT"/>
                                <ComboBoxItem Content="NTFS"/>
                                <ComboBoxItem Content="FAT32"/>
                            </ComboBox>
                            <TextBlock Text="Label:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="4,0,6,0"/>
                            <TextBox x:Name="FormatLabelBox" Style="{StaticResource DarkTextBox}" Width="130" Text="USB_DRIVE" Margin="0,0,8,4"/>
                            <CheckBox x:Name="ChkQuickFormat" Content="Quick" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,4"/>
                            <ComboBox x:Name="CmbPartStyle" Style="{StaticResource DarkComboBox}" Width="130" Margin="0,0,8,4" SelectedIndex="0">
                                <ComboBoxItem Content="MBR (best for USB)"/>
                                <ComboBoxItem Content="GPT (disks &gt; 2 TB)"/>
                            </ComboBox>
                            <Button Content="💾 Format Partition" Style="{StaticResource WarningButton}" Margin="0,0,6,4" Click="DriveFormat_Click"/>
                            <Button Content="⚠ Full Reset &amp; Format Whole Disk" Style="{StaticResource DangerButton}" Margin="0,0,6,4" Click="DriveReset_Click"
                                    ToolTip="Wipes the partition table and creates one clean partition — fixes RAW / corrupted / wrong-size pen drives"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <TextBox x:Name="DriveLogBox" Grid.Row="5" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="#070708" Foreground="#EADCB6" BorderBrush="#2E2614" BorderThickness="1" FontFamily="Consolas" FontSize="12" Padding="8"/>
            </Grid>

            <!-- ==================== PAGE: BOOT MENU MANAGER ==================== -->
            <Grid x:Name="PageBoot" Grid.Row="1" Visibility="Collapsed" Margin="20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.3*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="BootAdminBanner" Grid.Row="0" Background="#2A1F08" BorderBrush="#B8860B" BorderThickness="1" CornerRadius="8" Padding="14,9" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Restart as Administrator" Style="{StaticResource PrimaryButton}" Padding="12,6" Click="RestartAsAdmin_Click"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#FDE68A" FontSize="12.5"
                                   Text="Administrator rights are required to read or change boot entries."/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="BootScanBtn" Content="↻ Scan Boot Entries" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4" Click="BootScan_Click"/>
                            <Button Content="💾 Backup Boot Config" Style="{StaticResource GhostButton}" Margin="0,0,8,4" Click="BootBackup_Click"/>
                            <Button Content="♻ Restore Backup..." Style="{StaticResource GhostButton}" Margin="0,0,16,4" Click="BootRestore_Click"/>
                            <TextBlock Text="Menu timeout:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,6,4"/>
                            <ComboBox x:Name="CmbBootTimeout" Style="{StaticResource DarkComboBox}" Width="80" Margin="0,0,6,4" SelectedIndex="2">
                                <ComboBoxItem Content="0 s"/>
                                <ComboBoxItem Content="3 s"/>
                                <ComboBoxItem Content="5 s"/>
                                <ComboBoxItem Content="10 s"/>
                                <ComboBoxItem Content="15 s"/>
                                <ComboBoxItem Content="30 s"/>
                            </ComboBox>
                            <Button Content="Set" Style="{StaticResource ChipButton}" Margin="0,0,8,4" Click="BootSetTimeout_Click"/>
                        </WrapPanel>
                        <TextBlock FontSize="11.5" Foreground="#B5AA92" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Text="💡 Windows stores boot entries in the BCD store (a protected registry hive). FaimFixer edits it with Microsoft's official bcdedit tool and makes an automatic backup (BCD_Backups folder) before EVERY change. Windows Boot Manager, the running Windows and Recovery are locked 🔒."/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="BootStatusText" Grid.Row="2" Text="Click 'Scan Boot Entries' to list UEFI (BIOS boot menu) and Windows boot menu entries." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>

                <DataGrid x:Name="BootGrid" Grid.Row="3" Style="{StaticResource DarkDataGrid}" IsReadOnly="True">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRowStyle}">
                            <Setter Property="ToolTip" Value="{Binding InfoText}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Menu" Binding="{Binding Store}" Width="130"/>
                        <DataGridTextColumn Header="Boot Entry Name" Binding="{Binding DisplayName}" Width="200" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="Type" Width="190" SortMemberPath="Kind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding KindColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Kind}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Status" Width="210" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="In Menu" Binding="{Binding MenuText}" Width="70"/>
                        <DataGridTextColumn Header="" Binding="{Binding MarkerText}" Width="110" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Boot File / Device" Binding="{Binding TargetText}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,10">
                    <WrapPanel>
                        <Button Content="🗑 Delete Entry" Style="{StaticResource DangerButton}" Margin="0,0,6,4" Click="BootDelete_Click"/>
                        <Button Content="🙈 Hide from Menu" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="BootHide_Click"/>
                        <Button Content="👁 Show in Menu" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="BootShow_Click"/>
                        <Button Content="★ Set as Default" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="BootDefault_Click"/>
                        <Button Content="⬆ Boot First (UEFI)" Style="{StaticResource GhostButton}" Margin="0,0,6,4" Click="BootFirst_Click"/>
                        <Button Content="✏ Rename" Style="{StaticResource GhostButton}" Margin="0,0,14,4" Click="BootRename_Click"/>
                        <Button Content="➕ Add Safe Mode Entry" Style="{StaticResource SuccessButton}" Margin="0,0,6,4" Click="BootAddSafe_Click"/>
                        <Button Content="➕ Add Safe Mode + Network" Style="{StaticResource SuccessButton}" Margin="0,0,6,4" Click="BootAddSafeNet_Click"/>
                        <Button Content="➕ Add Windows Entry..." Style="{StaticResource SuccessButton}" Margin="0,0,6,4" Click="BootAddWindows_Click"/>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="EFI Partition Leftovers (old OS boot files)" FontWeight="Bold" Foreground="#F5C542" VerticalAlignment="Center"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="🔍 Scan EFI" Style="{StaticResource ChipButton}" Margin="0,0,6,0" Click="EfiScan_Click"/>
                                    <Button Content="🗑 Delete Selected (backup first)" Style="{StaticResource InlineDeleteButton}" Padding="8,4" Click="EfiDelete_Click"/>
                                </StackPanel>
                            </DockPanel>
                            <DataGrid x:Name="EfiGrid" Style="{StaticResource DarkDataGrid}" RowHeight="32">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkGridRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Note}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Del" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="\EFI\ Folder" Binding="{Binding Name}" Width="100" FontWeight="SemiBold" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Type" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding KindColor}" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="70" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Used by" Binding="{Binding ReferencedBy}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <TextBox x:Name="BootLogBox" Grid.Column="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="#070708" Foreground="#EADCB6" BorderBrush="#2E2614" BorderThickness="1" FontFamily="Consolas" FontSize="11.5" Padding="8"/>
                </Grid>
            </Grid>

            <!-- ==================== PAGE 7: SYSTEM JUNK CLEANER ==================== -->
            <Grid x:Name="PageJunk" Grid.Row="1" Visibility="Collapsed" Margin="20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <TextBlock Text="Safe Windows Junk &amp; Cache Cleaner" FontSize="14.5" FontWeight="Bold"/>
                            <TextBlock Text="Analyze temporary files, crash dumps, Windows Update downloads, and Recycle Bin before cleaning." FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="JunkAnalyzeBtn" Content="🔍 Analyze System Junk" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="JunkAnalyze_Click"/>
                            <Button x:Name="JunkCleanBtn" Content="🧹 Clean Selected" Style="{StaticResource SuccessButton}" Click="JunkClean_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock x:Name="JunkStatusText" Grid.Row="1" Text="Click 'Analyze System Junk' to calculate reclaimable space." FontSize="12.5" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>

                <DataGrid x:Name="JunkGrid" Grid.Row="2" Style="{StaticResource DarkDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Clean" Width="54">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Category" Binding="{Binding Name}" Width="230" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="85" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeFormatted}" Width="110" IsReadOnly="True" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Location / Details" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,0">
                    <TextBlock x:Name="JunkSummaryText" Text="Total reclaimable: 0 B" FontSize="13" FontWeight="SemiBold" Foreground="#34D399"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
